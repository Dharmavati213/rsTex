{
 "source": "selfcheck",
 "description": "Purpose-built documents for run.py selfcheck. They sit outside manifests/ on purpose, so they never count toward any corpus denominator.",
 "entries": [
  {
   "id": "fx/random",
   "main": "tests/corpus/fixtures/fx-random.tex",
   "expected_class": "nondeterministic",
   "notes": "\\pdfuniformdeviate is seeded from the clock"
  },
  {
   "id": "fx/seeded-random",
   "main": "tests/corpus/fixtures/fx-random.tex",
   "prelude": "\\pdfsetrandomseed 42 ",
   "notes": "the same document, made comparable by fixing the seed in the prelude"
  },
  {
   "id": "fx/missing-input",
   "main": "tests/corpus/fixtures/fx-missing.tex",
   "expected_class": "oracle-fails"
  },
  {
